<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <changeSet id="202303-0002-1" author="fatih.yildiz">
        <createTable tableName="hastalik">
            <column name="id" type="${uuid_type}" defaultValueComputed="${uuid_function}">
                <constraints primaryKey="true" nullable="false" primaryKeyName="hastalik_pk"/>
            </column>
            <column name="adi" type="varchar2(150)">
                <constraints nullable="false"/>
            </column>
            <column name="tanim" type="varchar2(4000)"/>
            <column name="belirtiler" type="varchar2(4000)"/>
            <column name="yapilmasi_gerekenler" type="varchar2(4000)"/>
            <column name="yapilmamasi_gerekenler" type="varchar2(4000)"/>
            <column name="last_modified_by" type="varchar2(50)"/>
            <column name="last_modified_date" type="timestamp" defaultValueComputed="current_timestamp"/>
            <column name="created_by" type="varchar2(50)"/>
            <column name="created_date" type="timestamp" defaultValueComputed="current_timestamp"/>
        </createTable>
        <createIndex tableName="hastalik" indexName="hastalik_adi_idx">
            <column name="adi"></column>
        </createIndex>
    </changeSet>
</databaseChangeLog>
